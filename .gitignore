# 忽略运行产物与依赖
runs/*
!runs/.gitkeep

# B1 状态目录（本地采纳/回退、事件、账本）
state/
evidence/

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

node_modules/
npm-debug.log*

# 本地覆盖与凭据
.env
.pi/

# probe 原始流（体积大，不入库）
probes/report/**/response*.jsonl

# 现场 probe 产出：由 probes/run_demo.py 生成，不入库
# - state.json / run.json 是当场证据（页面轮询用）
# - live.md 是当场反思产出，genome artifacts 只在本次运行内引用
web/data/probe/state.json
web/data/probe/run.json
shells/probe/memory/live.md

# 本地工作备份与临时导出
backup/
*.bak-*
web/page/*.bak-*
.playwright-mcp/

{
  "schema_version": "1.0.0",
  "task_id": "svc-logging",
  "scenario_version": "svc-1",
  "shell_id": "svc-config",
  "scope": "search",
  "title": "修好日志级别与重试次数",
  "workspace_ref": "bench/search/svc-logging/workspace",
  "tests_ref": "bench/search/svc-logging/tests",
  "timeout_s": 30,
  "ext": {
    "deterministic": {
      "edits": [
        {
          "kind": "json_set",
          "path": "config/app.json",
          "pointer": "/logging/level",
          "value": "info"
        },
        {
          "kind": "json_set",
          "path": "config/app.json",
          "pointer": "/logging/retries",
          "value": 3,
          "when": {
            "thinking": ["high"]
          }
        }
      ]
    }
  }
}

        "code_after": "\"\"\"Unique helpers.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef unique(names: list[str]) -> list[str]:\n    \"\"\"Drop duplicate names and return them in this package's preferred sequence.\n\n    Names that differ only by case are duplicates; among each such group the\n    case-sensitive lexicographically smallest spelling is kept (so all-uppercase\n    beats mixed/lowercase).  The result is ordered by length, then by\n    case-sensitive lexicographic order.\n\n    >>> unique([\"cc\", \"bb\"])\n    ['bb', 'cc']\n    >>> unique([\"dd\", \"ee\"])\n    ['dd', 'ee']\n    >>> unique([\"apple\", \"APPLE\", \"Apple\"])\n    ['APPLE']\n    \"\"\"\n    keep: dict[str, str] = {}\n    for name in names:\n        key = name.lower()\n        if key not in keep or name < keep[key]:\n            keep[key] = name\n    return sorted(keep.values(), key=lambda s: (len(s), s))\n",

{
  "openapi": "3.0.3",
  "info": {
    "title": "molt local agent API",
    "version": "1.0.0",
    "description": "Batch A+B 合并 MVP：probe 实验投影 + 内存 session/SSE chat。仅 loopback，Bearer 鉴权，不做持久化。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:0",
      "description": "实际端口见 molt serve 的 stdout listen 字段"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "健康检查（免鉴权）",
        "security": [],
        "responses": {
          "200": {
            "description": "服务与 provider 状态；不含 base URL / key / token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "provider",
                    "model",
                    "real_model",
                    "adapter_ready",
                    "provider_error"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "provider": {
                      "type": "string",
                      "enum": [
                        "mock",
                        "openai-compatible"
                      ]
                    },
                    "model": {
                      "type": "string"
                    },
                    "real_model": {
                      "type": "boolean"
                    },
                    "adapter_ready": {
                      "type": "boolean"
                    },
                    "provider_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Host 非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "openapiDoc",
        "summary": "本契约（免鉴权）",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 文档",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments": {
      "get": {
        "operationId": "listExperiments",
        "summary": "8 条 probe 实验投影",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "实验索引",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentIndex"
                }
              }
            }
          },
          "401": {
            "description": "缺少/错误 Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments/{experiment_id}": {
      "get": {
        "operationId": "getExperiment",
        "summary": "单条实验投影",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实验投影",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Experiment"
                }
              }
            }
          },
          "401": {
            "description": "缺少/错误 Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未知 experiment_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTaskResults",
        "summary": "搜索集逐题 first/second 成本与通过（顺序同 scenario）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "任务结果；first=scan10（缺失用 closure replay），second=candidate-scan（缺失用 closure live）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResults"
                }
              }
            }
          },
          "401": {
            "description": "缺少/错误 Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "数据文件缺失或 JSON 非法（data_unavailable）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "创建会话（只接受 {}）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是 {}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "缺少/错误 Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type 不是 application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSessions",
        "summary": "列出会话（进程内）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "会话列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sessions"
                  ],
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SessionSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "缺少/错误 Bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "operationId": "getSession",
        "summary": "读取会话",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "会话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "404": {
            "description": "未知 session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSession",
        "summary": "删除空闲会话（in_progress → 409）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已删除"
          },
          "404": {
            "description": "未知 session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "turn 进行中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "post": {
        "operationId": "createMessage",
        "summary": "提交一条 user 消息（异步 turn）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已接受；event_cursor 首轮为 null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "turn_id",
                    "event_cursor"
                  ],
                  "properties": {
                    "turn_id": {
                      "type": "string"
                    },
                    "event_cursor": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "content 不合法或含未知字段",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未知 session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "已有 turn 进行中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求体 > 64 KiB 或历史 ≥200 条",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type 不是 application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/events": {
      "get": {
        "operationId": "streamEvents",
        "summary": "SSE 事件流（replay + live tail）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "正数排他；缺省/0 从最旧保留开始"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream；error 或 done 后关闭",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "since 不是非负整数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "未知 session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "since 早于最旧保留，details.reset_required=true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthorized",
                  "forbidden_origin",
                  "not_found",
                  "method_not_allowed",
                  "conflict",
                  "stale_event_id",
                  "payload_too_large",
                  "unsupported_media_type",
                  "internal",
                  "adapter_unavailable",
                  "data_unavailable",
                  "upstream_timeout",
                  "upstream_unavailable",
                  "upstream_auth_failed",
                  "upstream_rate_limited",
                  "upstream_error",
                  "tool_denied",
                  "too_many_tool_calls"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "Experiment": {
        "type": "object",
        "description": "字段级契约见 contracts/schemas/experiment.schema.json",
        "required": [
          "experiment_id",
          "title",
          "study_kind",
          "stage",
          "status",
          "provenance",
          "scenario_version",
          "shell_version",
          "verifier_hash",
          "task_scope",
          "metrics",
          "comparison",
          "evidence",
          "comparability_key",
          "caveats"
        ],
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "study_kind": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "provenance": {
            "type": "object"
          },
          "scenario_version": {
            "type": "string",
            "nullable": true
          },
          "shell_version": {
            "type": "string",
            "nullable": true
          },
          "verifier_hash": {
            "type": "string",
            "nullable": true
          },
          "task_scope": {
            "type": "object"
          },
          "metrics": {
            "type": "object"
          },
          "comparison": {
            "type": "object"
          },
          "evidence": {
            "type": "object"
          },
          "comparability_key": {
            "type": "string",
            "nullable": true
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ExperimentIndex": {
        "type": "object",
        "required": [
          "schema_version",
          "generated_at",
          "revision",
          "experiments"
        ],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "experiments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Experiment"
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "TaskResults": {
        "type": "object",
        "description": "字段级契约见 contracts/schemas/task-results.schema.json",
        "additionalProperties": false,
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "cost_first",
                "passed_first",
                "cost_second",
                "passed_second"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "cost_first": {
                  "type": "number",
                  "minimum": 0
                },
                "passed_first": {
                  "type": "boolean"
                },
                "cost_second": {
                  "type": "number",
                  "minimum": 0
                },
                "passed_second": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "session_id",
          "status",
          "provider",
          "created_at",
          "messages",
          "last_event_id"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "in_progress"
            ]
          },
          "provider": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_event_id": {
            "type": "integer"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SessionSummary": {
        "type": "object",
        "description": "GET /api/sessions 的摘要项；不含 messages。",
        "additionalProperties": false,
        "required": [
          "session_id",
          "status",
          "provider",
          "created_at",
          "last_event_id",
          "message_count"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "in_progress"
            ]
          },
          "provider": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_event_id": {
            "type": "integer"
          },
          "message_count": {
            "type": "integer"
          }
        }
      },
      "SessionCreateRequest": {
        "type": "object",
        "maxProperties": 0,
        "additionalProperties": false
      },
      "MessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        }
      }
    }
  }
}

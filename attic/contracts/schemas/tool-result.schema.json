{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.local/schemas/tool-result.schema.json",
  "title": "tool.result event data",
  "description": "工具执行结果。status=ok 时带 result；status=error/denied 时带 reason。工具错误仍会进入第二次上游调用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn_id", "call_id", "tool", "status"],
  "properties": {
    "turn_id": { "type": "string", "minLength": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "enum": ["experiments_list", "experiments_get"] },
    "status": { "type": "string", "enum": ["ok", "error", "denied"] },
    "result": {},
    "reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": { "required": ["result"] },
      "else": { "required": ["reason"] }
    }
  ]
}

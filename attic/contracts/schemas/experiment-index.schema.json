{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.local/schemas/experiment-index.schema.json",
  "title": "probe experiment index",
  "description": "GET /api/experiments 的完整响应体；revision 是去掉 revision 后规范化 JSON 的 sha256。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "revision", "experiments"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://molt.local/schemas/experiment.schema.json" }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "reason"],
        "properties": {
          "experiment_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

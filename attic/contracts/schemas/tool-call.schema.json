{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.local/schemas/tool-call.schema.json",
  "title": "tool.call event data",
  "description": "turn 内的一次工具调用；工具名只有 experiments_list / experiments_get（下划线形式，点号非法）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn_id", "call_id", "tool", "arguments"],
  "properties": {
    "turn_id": { "type": "string", "minLength": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "enum": ["experiments_list", "experiments_get"] },
    "arguments": { "type": "object" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.local/schemas/session-summary.schema.json",
  "title": "agent session summary",
  "description": "GET /api/sessions 的 sessions[] 项：固定 6 键，不含 messages。完整 session 只在 GET /api/sessions/{id} 返回。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "provider",
    "created_at",
    "last_event_id",
    "message_count"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["idle", "in_progress"] },
    "provider": { "type": "string", "enum": ["mock", "openai-compatible"] },
    "created_at": { "type": "string", "minLength": 1 },
    "last_event_id": { "type": "integer", "minimum": 0 },
    "message_count": { "type": "integer", "minimum": 0 }
  }
}

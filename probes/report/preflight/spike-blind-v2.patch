+    """解析阈值；``None`` 表示配置缺失，返回值应落在 [MIN_THRESHOLD, MAX_THRESHOLD]。
+
+    配置缺失抛 ``ConfigError``，非法值抛 ``ValidationError``；
+    两者均按仓库约定记录拒绝日志后抛出。
+    """
+    if text is None:
+        message = format_error("missing_key", "load_threshold")
+        logger.error("%s%s", REJECTION_PREFIX, message)
+        raise ConfigError(message)
+
+    try:
+        value = int(text)
+    except (TypeError, ValueError):
+        message = format_error("invalid_type", "load_threshold not an integer")
+        logger.error("%s%s", REJECTION_PREFIX, message)
+        raise ValidationError(message) from None
+
+    if not MIN_THRESHOLD <= value <= MAX_THRESHOLD:
+        message = format_error(
+            "invalid_threshold",
+            f"load_threshold {value} out of range [{MIN_THRESHOLD}, {MAX_THRESHOLD}]",
+        )
+        logger.error("%s%s", REJECTION_PREFIX, message)
+        raise ValidationError(message)
+
+    return value

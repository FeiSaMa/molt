{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.local/schemas/error.schema.json",
  "title": "API error envelope",
  "description": "HTTP 错误响应体；code 的闭集与 molt/agent/errors.py 的 ErrorCode 一致（含仅用于 SSE error 事件的码）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthorized",
            "forbidden_origin",
            "not_found",
            "method_not_allowed",
            "conflict",
            "stale_event_id",
            "payload_too_large",
            "unsupported_media_type",
            "internal",
            "adapter_unavailable",
            "data_unavailable",
            "upstream_timeout",
            "upstream_unavailable",
            "upstream_auth_failed",
            "upstream_rate_limited",
            "upstream_error",
            "tool_denied",
            "too_many_tool_calls",
            "tool_budget_exceeded",
            "skill_integrity_mismatch",
            "mcp_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}

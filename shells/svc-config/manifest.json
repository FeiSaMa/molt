{
  "schema_version": "1.0.0",
  "shell_id": "svc-config",
  "shell_version": "1.0.0",
  "name": "svc-config",
  "artifact_roots": [
    "molt/core",
    "molt/shell_bundle.py",
    "schemas/v1",
    "shells/svc-config"
  ],
  "entrypoints": {
    "harness": "shells/svc-config/harness.py",
    "verifier": "shells/svc-config/verifier.py",
    "task_provider": "shells/svc-config/task_provider.py"
  },
  "capabilities": {
    "switch_domains": {
      "thinking": ["low", "high"],
      "context": ["full", "minimal"],
      "tools": ["bash"]
    },
    "max_execution_budget_usd": 0.0,
    "max_wall_ms": 60000,
    "max_turns": 1,
    "max_attempts": 1
  },
  "ext": {
    "default_runtime": "deterministic",
    "note": "确定性配置修复 shell：复用 v1 三字段，零 LLM / 零网络 / 零成本；不涉及任何智能增益"
  }
}
